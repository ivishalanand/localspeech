{
  "name": "localspeech",
  "version": "1.0.0",
  "description": "Local TTS reader — select text, press ⌘⇧R, it reads aloud",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/smoke.js && bash test/verify.sh",
    "test:tts": "electron test/smoke.js",
    "test:e2e": "bash test/verify.sh",
    "postinstall": "electron-rebuild -f -w onnxruntime-node"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "kokoro-js": "^1.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0"
  }
}
